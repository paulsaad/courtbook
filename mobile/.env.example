# Copy to mobile/.env for a local run. For EAS builds these are set as EAS
# environment variables in the Expo dashboard instead, so they stay out of git.
#
# Both values are the same ones the web app uses. The anon key is protected by
# row-level security and is already public in the web bundle; it is kept out of
# the repo anyway, so there is one rule about secrets rather than two.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
