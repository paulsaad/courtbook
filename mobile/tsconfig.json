{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@shared/*": ["../src/lib/*"],
      "date-fns": ["./node_modules/date-fns"],
      "date-fns-tz": ["./node_modules/date-fns-tz"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
