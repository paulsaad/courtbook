# Copy to .env.local for local dev. In Vercel, set these in Project → Settings → Environment Variables.
# Both values are public (the anon key is safe in the browser; RLS does the protection).
NEXT_PUBLIC_SUPABASE_URL=https://lgujfbwunokobjxlvpuf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase → Project Settings → API Keys → Secret key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Payment provider: simulated (default) | whish. Must match the DB setting app.payment_provider used by hold_slot.
PAYMENT_PROVIDER=simulated
# Optional: email notifications through Gmail SMTP (same app password as Supabase SMTP). Unset = in-app only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
