# Copy to .env.local for local dev. In Vercel, set these in Project → Settings → Environment Variables.
# Both values are public (the key is safe in the browser; RLS does the protection). The variable keeps its old name:
# its value is the project's publishable key (sb_publishable_…). The legacy anon key (eyJ…) also works until legacy
# keys are disabled for that project.
NEXT_PUBLIC_SUPABASE_URL=https://lgujfbwunokobjxlvpuf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Supabase → Project Settings → API Keys → a named secret key (sb_secret_…), one per place it is used
# (e.g. vercel_production, vercel_preview). The variable keeps its old name. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Payment provider: simulated (default) | whish. Must match the DB setting app.payment_provider used by hold_slot.
PAYMENT_PROVIDER=simulated
# Optional: email notifications through Gmail SMTP (same app password as Supabase SMTP). Unset = in-app only.
GMAIL_USER=
GMAIL_APP_PASSWORD=
